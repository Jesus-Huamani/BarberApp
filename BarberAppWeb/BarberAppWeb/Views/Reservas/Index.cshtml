@model List<BarberAppWeb.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<div class="container mt-4">

    <h1 class="mb-4">Reservas de la Barbería</h1>
    
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Mensaje"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["Error"]
        </div>
    }

    <table class="table table-striped table-bordered">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Servicio</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var reserva in Model)
            {
                <tr>
                    <td>@reserva.IdReserva</td>

                    <td>
                        @reserva.Usuario?.Nombre
                        @reserva.Usuario?.Apellido
                    </td>

                    <td>
                        @reserva.Servicio?.Nombre
                    </td>

                    <td>
                        @reserva.Fecha.ToString("dd/MM/yyyy")
                    </td>

                    <td>
                        @reserva.Hora
                    </td>

                    <td>
                        @if (reserva.Estado == "CONFIRMADA")
                        {
                            <span class="badge bg-success">
                                CONFIRMADA
                            </span>
                        }
                        else if (reserva.Estado == "CANCELADA")
                        {
                            <span class="badge bg-danger">
                                CANCELADA
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">
                                PENDIENTE
                            </span>
                        }
                    </td>

                    <td>
                        @if (reserva.Estado == "PENDIENTE")
                        {
                            <form asp-action="Confirmar"
                                  method="post"
                                  style="display:inline">

                                <input type="hidden"
                                       name="id"
                                       value="@reserva.IdReserva" />

                                <button type="submit"
                                        class="btn btn-success btn-sm">
                                    Confirmar
                                </button>
                            </form>

                            <form asp-action="Cancelar"
                                  method="post"
                                  style="display:inline">

                                <input type="hidden"
                                       name="id"
                                       value="@reserva.IdReserva" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Cancelar
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">
                                Sin acciones
                            </span>
                        }
                    </td>

                </tr>
            }
        </tbody>

    </table>

</div>
